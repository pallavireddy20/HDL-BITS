module top_module(
    input [399:0] a,
    input [399:0] b,
    input cin,
    output cout,
    output [399:0] sum
);

    wire [99:0] c;      // Internal carry wires
    genvar i;

    generate
        for(i = 0; i < 100; i = i + 1)
        begin : BCD

            if(i == 0)
                bcd_fadd fa(
                    .a(a[4*i+3 : 4*i]),
                    .b(b[4*i+3 : 4*i]),
                    .cin(cin),
                    .cout(c[0]),
                    .sum(sum[4*i+3 : 4*i])
                );
            else
                bcd_fadd fa(
                    .a(a[4*i+3 : 4*i]),
                    .b(b[4*i+3 : 4*i]),
                    .cin(c[i-1]),
                    .cout(c[i]),
                    .sum(sum[4*i+3 : 4*i])
                );

        end
    endgenerate

    assign cout = c[99];

endmodule
